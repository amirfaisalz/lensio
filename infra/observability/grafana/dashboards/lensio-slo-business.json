      "targets": [
        {
          "expr": "clamp_max(clamp_min((1 - ((sum(rate(http_errors_total{route=\"/api/v1/ocr/ktp\"}[5m])) / clamp_min(sum(rate(http_requests_total{route=\"/api/v1/ocr/ktp\"}[5m])), 0.001)) / 0.01)) * 100, 0), 100)",
