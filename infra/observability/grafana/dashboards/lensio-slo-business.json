      "targets": [
        {
          "expr": "100 - ((sum(rate(http_errors_total{route=\"/api/v1/ocr/ktp\"}[5m])) / clamp_min(sum(rate(http_requests_total{route=\"/api/v1/ocr/ktp\"}[5m])), 0.001)) * 100)",
          "legendFormat": "Availability %"
        }
      ],
      "title": "SLO Target: Availability (> 99.0%)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 20.0 },
              { "color": "green", "value": 50.0 }
            ]
          },
          "unit": "percent",
          "max": 100.0,
          "min": 0.0
