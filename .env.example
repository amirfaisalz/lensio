# NusaID Environment Configuration
PORT=8080
ENV=development
DATABASE_URL=postgres://nusaid:nusaid_dev_password@localhost:5432/nusaid?sslmode=disable
LOG_LEVEL=info

# OCR Engine Configuration
# Pilihan OCR_PROVIDER: "gemini_flash" (atau "gemini") untuk AI Vision asli, atau "mock" untuk fixture testing
OCR_PROVIDER=gemini_flash
GEMINI_API_KEY=your_gemini_api_key_here
# Pilihan model: "gemini-3.6-flash" (rekomendasi terkini), "gemini-2.5-flash", atau "gemini-1.5-flash"
GEMINI_MODEL=gemini-3.6-flash
