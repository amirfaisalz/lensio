# Lensio Environment Configuration
PORT=8080
ENV=development
DATABASE_URL=postgres://lensio:lensio_dev_password@localhost:5432/lensio?sslmode=disable
LOG_LEVEL=info

# OCR Engine Configuration
# Pilihan OCR_PROVIDER: "gemini_flash" (atau "gemini") untuk AI Vision asli, atau "mock" untuk fixture testing
OCR_PROVIDER=gemini_flash
GEMINI_API_KEY=your_gemini_api_key_here
# Opsional. Kosongkan untuk memakai default milik provider (services/ocr/providers/gemini.go).
GEMINI_MODEL=

# Session & Security
# WAJIB di production/staging: menandatangani cookie sesi DAN menurunkan kunci
# enkripsi cache idempotency. API menolak start tanpa ini di prod/staging.
SESSION_SECRET=change_me_min_32_bytes_random

# Origin browser yang boleh memanggil API dengan credentials (origin dashboard).
# Kosong = tidak ada header CORS sama sekali -> dashboard tidak bisa memanggil API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Jumlah replika API. Token bucket rate limit hidup per-proses, jadi limit paket
# dibagi angka ini agar total mendekati limit yang dijual. Default 1.
RATE_LIMIT_REPLICAS=1

# Mengaktifkan DevTokenValidator yang MENERIMA JWT TANPA TANDA TANGAN.
# Hanya untuk development lokal. Diabaikan paksa di production/staging.
ENABLE_DEV_AUTH=false

# Transactional Email (WAJIB di production/staging)
# Tanpa SMTP_HOST, token verifikasi dibuat lalu tidak pernah terkirim: user
# mendaftar, tidak bisa verifikasi, dan tidak bisa masuk selamanya. API menolak
# start di production/staging tanpa ini. Di development, link ditulis ke log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@lensio.dev

# Origin dashboard, dipakai untuk membangun tautan di dalam email tersebut.
APP_BASE_URL=http://localhost:5173
